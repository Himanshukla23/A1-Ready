{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/doro",
      "dest": "/api/doro.js"
    },
    {
      "src": "/api/evaluate-speaking",
      "dest": "/api/evaluate-speaking.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
