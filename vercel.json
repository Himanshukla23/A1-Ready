{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "includeFiles": "knowledge-base/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/doro",
      "destination": "/api/doro.js"
    },
    {
      "source": "/api/evaluate-speaking",
      "destination": "/api/evaluate-speaking.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
